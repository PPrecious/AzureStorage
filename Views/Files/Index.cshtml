@model List<AzureStorageWebApp.Models.LogFileViewModel>

@{
    ViewData["Title"] = "Azure Files";
}


<div class="container-fluid">

    <!-- ========================================================
         PAGE HEADER
         ======================================================== -->

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2 class="mb-1">

                Azure Files —
                Application Logs

            </h2>

            <p class="text-muted mb-0">

                File share:
                <strong>applicationlogs</strong>

            </p>

        </div>


        <span class="badge text-bg-primary fs-6">

            @Model.Count files

        </span>

    </div>


    <!-- ========================================================
         SUCCESS MESSAGE
         ======================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <strong>Success:</strong>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================
         ERROR MESSAGE
         ======================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <strong>Azure Storage connection error:</strong>

            <div class="mt-1">

                @TempData["Error"]

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================
         CREATE LOG FILE
         ======================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h5 class="card-title">

                Create Log File

            </h5>


            <p class="text-muted">

                Enter a message below to create a new
                log file in the Azure Files
                <strong>applicationlogs</strong> share.

            </p>


            <form asp-action="CreateLog"
                  method="post"
                  class="row g-2">

                @Html.AntiForgeryToken()


                <div class="col-md-10">

                    <label for="message"
                           class="visually-hidden">

                        Log Message

                    </label>


                    <input id="message"
                           name="message"
                           type="text"
                           class="form-control"
                           placeholder="Enter log message"
                           maxlength="500"
                           required />

                </div>


                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Create Log

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================
         STORED LOG FILES
         ======================================================== -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex
                justify-content-between
                align-items-center
                mb-3">

                <h5 class="card-title mb-0">

                    Stored Log Files

                </h5>


                <span class="badge text-bg-secondary">

                    Azure Files

                </span>

            </div>


            <div class="table-responsive">

                <table class="table
                    table-striped
                    table-hover
                    align-middle
                    mb-0">

                    <thead>

                        <tr>

                            <th>
                                File Name
                            </th>

                            <th>
                                Size
                            </th>

                            <th>
                                Last Modified
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Count == 0)
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center
                                    text-muted
                                    py-5">

                                    <div class="mb-2">

                                        <strong>
                                            No log files found.
                                        </strong>

                                    </div>

                                    <small>

                                        Upload a log file
                                        or use the
                                        Create Log button
                                        above.

                                    </small>

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var file in Model)
                            {
                                <tr>

                                    <td class="text-break">

                                        <strong>

                                            @file.FileName

                                        </strong>

                                    </td>


                                    <td>

                                        @file.Size bytes

                                    </td>


                                    <td>

                                        @file.LastModified
                                        .ToLocalTime()
                                        .ToString(
                                        "dd MMM yyyy HH:mm:ss")

                                    </td>


                                    <td>

                                        <a class="btn
                                            btn-sm
                                            btn-outline-primary"
                                               asp-action="Download"
                                               asp-route-name="@file.FileName">

                                            Download

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



</div>