@model AzureStorageWebApp.Models.QueuePageViewModel

@{
    ViewData["Title"] = "Queues";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="mb-1">
            Orders &amp; Inventory Queue
        </h2>

        <p class="text-muted mb-0">

            Azure Queue:
            <strong>orderprocessing</strong>

        </p>

    </div>


    <span class="badge text-bg-primary fs-6">

        @Model.ApproximateMessageCount
        messages

    </span>

</div>


<!-- =========================================================
     SEND QUEUE MESSAGE
     ========================================================= -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <h5 class="card-title mb-3">

            Add Queue Transaction

        </h5>


        <form asp-action="Send"
              method="post"
              class="row g-3">

            @Html.AntiForgeryToken()


            <!-- MESSAGE TYPE -->

            <div class="col-md-3">

                <label for="type"
                       class="form-label">

                    Transaction Type

                </label>


                <select name="type"
                        id="type"
                        class="form-select">

                    <option value="Order">

                        Order

                    </option>


                    <option value="Inventory">

                        Inventory

                    </option>

                </select>

            </div>


            <!-- MESSAGE -->

            <div class="col-md-7">

                <label for="message"
                       class="form-label">

                    Queue Message

                </label>


                <input type="text"
                       name="message"
                       id="message"
                       class="form-control"
                       placeholder="Enter order or inventory message"
                       maxlength="500"
                       required />

            </div>


            <!-- SEND -->

            <div class="col-md-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    Send Message

                </button>

            </div>

        </form>

    </div>

</div>

<!-- =========================================================
     QUEUE MESSAGES
     ========================================================= -->

<div class="card shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between
            align-items-center mb-3">

            <h5 class="card-title mb-0">

                Queue Messages

            </h5>


            <span class="badge text-bg-secondary">

                @Model.Messages.Count visible

            </span>

        </div>


        @if (Model.Messages.Count == 0)
        {
            <div class="alert alert-warning mb-0">

                <strong>No queue messages found.</strong>

                <br />

                Use the form above to add a new
                Order or Inventory message.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped
                    table-hover
                    align-middle mb-0">

                    <thead>

                        <tr>

                            <th style="width: 80px;">

                                #

                            </th>

                            <th>

                                Message

                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @for (
                            var i = 0;
                            i < Model.Messages.Count;
                            i++)
                        {
                            <tr>

                                <td>

                                    @(i + 1)

                                </td>


                                <td class="text-break">

                                    <code>

                                        @Model.Messages[i]

                                    </code>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>